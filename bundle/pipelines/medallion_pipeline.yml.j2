# bundle/pipelines/medallion_pipeline.yml.j2
resources:
  pipelines:
    medallion_dlt_pipeline:
      name: "[{{ environment }}] Medallion NYC Taxi DLT Pipeline"
      catalog: "${var.catalog}"
      target: "${var.schema_prefix}_medallion_nyctaxi"

      edition: ADVANCED
      channel: CURRENT
      continuous: false
      development: false

      # Compute Configuration: Serverless compute enabled
      serverless: true

      # Libraries & Code Sources (Auto-discovered via Jinja2 glob)
      libraries:
        {% for file in glob_files("src/models/**/*.py") %}
        - notebook:
            path: ../../{{ file }}
        {% endfor %}

      # Runtime Configuration
      configuration:
        bundle.target: "${bundle.target}"
        catalog: "${var.catalog}"
        schema_prefix: "${var.schema_prefix}"

      # Trigger & Schedule
      {% if environment == 'prod' %}
      trigger:
        cron:
{% filter indent(10) %}
{% include "includes/schedule.yml.j2" %}
{% endfilter %}
      {% endif %}

      # Governance, Tags & Permissions
{% filter indent(6) %}
{% include "includes/tags.yml.j2" %}
{% include "includes/permissions.yml.j2" %}
{% endfilter %}

      notifications:
        - email_recipients:
            - dev-alerts@company.com
          alerts:
            - "on-update-failure"
