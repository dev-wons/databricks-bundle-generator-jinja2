clusters:
  - label: default
    node_type_id: "${var.node_type_id}"
    driver_node_type_id: "${var.node_type_id}"
    autoscale:
      min_workers: {% if environment == 'prod' %}2{% else %}1{% endif %}
      max_workers: {% if environment == 'prod' %}4{% else %}2{% endif %}
    spark_conf:
      spark.databricks.delta.preview.enabled: "true"
