# bundle/workflows/medallion_workflow.yml.j2
resources:
  jobs:
    medallion_unified_workflow:
      name: "[{{ environment }}] Medallion Unified Bronze-Silver-Gold Workflow"

      # Job Cluster Configuration
      job_clusters:
        - job_cluster_key: medallion_standard_cluster
          new_cluster:
            spark_version: "${var.spark_version}"
            node_type_id: "${var.node_type_id}"
            num_workers: {% if environment == 'prod' %}2{% else %}1{% endif %}
            spark_conf:
              spark.databricks.delta.preview.enabled: "true"

      # Tasks Execution Graph
      tasks:
        - task_key: run_unified_medallion_pipeline
          pipeline_task:
            pipeline_id: "${resources.pipelines.medallion_dlt_pipeline.id}"

      # Schedule
      {% if environment == 'prod' %}
      schedule:
{% filter indent(8) %}
{% include "includes/schedule.yml.j2" %}
{% endfilter %}
      {% endif %}

      # Governance, Tags & Permissions
{% filter indent(6) %}
{% include "includes/tags.yml.j2" %}
{% include "includes/permissions.yml.j2" %}
{% endfilter %}

      email_notifications:
        on_failure:
          - dev-alerts@company.com
